#!/bin/sh
# Internal implementations; argument validation and help belong to the Rust CLI.
set -eu
cd "$(dirname "$0")/.."
export BUCK_ISOLATION_DIR=${BUCK_ISOLATION_DIR:-dev}

dotslash() {
    tools/bootstrap-dotslash >/dev/null
    tool="$PWD/.buck2-tools/bin/dotslash"
    if [ ! -x "$tool" ] && [ -x "$tool.exe" ]; then tool="$tool.exe"; fi
    "$tool" "$@"
}

hooks() {
    if [ -d .jj ]; then
        live_files=$(jj file list)
        old_ifs=$IFS
        IFS='
'
        set -- "$@" --files $live_files
        IFS=$old_ifs
    else
        set -- "$@" --all-files
    fi
    dotslash tools/prek run "$@" --config .config/prek.toml
}

format() {
    if [ "$1" = check ]; then
        hooks check-rust check-python-format
    else
        hooks trailing-whitespace end-of-file-fixer repair-rust repair-python-format
    fi
}

test_repository() {
    case "${BLCKBAUX_BUILD_SYSTEM:-buck2}" in
        buck2) ./buck2w test //build/buck2/tests:all --local-only ;;
        bazel) bazel test //:check --config=release --config=constrained ;;
    esac
}

test_affected() {
    gate_out=$(tools/ripwirew . --test-gate 2>&1 || true)
    gate_files=$(printf '%s\n' "$gate_out" | grep -o 'p="[^"]*test[^"]*"' | cut -d'"' -f2 | sort -u || true)
    dirty_files=$(jj diff --name-only --no-pager 2>/dev/null || true)
    candidates=$(printf '%s\n%s\n' "$gate_files" "$dirty_files" | grep -E '\.rs$' | sort -u || true)
    if [ -z "$candidates" ]; then
        echo "blckbaux: no changed Rust files or test obligations found"
        return 0
    fi
    targets=""
    for item in $candidates; do
        if [ -f "$item" ]; then
            found=$(./buck2w uquery "kind(test, owner('$item'))" 2>/dev/null || true)
            if [ -n "$found" ]; then
                targets="$targets $found"
            fi
        fi
    done
    targets=$(printf '%s\n' $targets | sort -u || true)
    if [ -z "$targets" ]; then
        echo "blckbaux: no Buck2 test targets mapped to affected files"
        return 0
    fi
    echo "blckbaux: running affected test targets:"
    printf '  %s\n' $targets
    case "${BLCKBAUX_BUILD_SYSTEM:-buck2}" in
        buck2) ./buck2w test $targets --local-only -j 1 ;;
        bazel) bazel test $targets --config=release --config=constrained ;;
    esac
}

build_native() {
    verification=$1
    case "${BLCKBAUX_BUILD_SYSTEM:-buck2}" in
        buck2)
            ./buck2w build //rust/crates/blckbaux:blckbaux --local-only
            if [ "$verification" = full ]; then
                test_repository
            fi
            ;;
        bazel)
            bazel build //:cpu //:gpu --config=constrained
            if [ "$verification" = full ]; then
                test_repository
            fi
            ;;
        *)
            echo "blckbaux: unsupported build system: ${BLCKBAUX_BUILD_SYSTEM}" >&2
            exit 1
            ;;
    esac
}

build_distribution() {
    verification=$1
    destination=$2
    bash tools/build-wheels "$destination" "$verification"
}

validate_verification() {
    case "$1" in
        smoke | full) ;;
        *) echo "blckbaux: unknown verification level: $1" >&2; exit 1 ;;
    esac
}

action=$1
shift
case "$action" in
    fmt) format "$@" ;;
    build)
        kind=$1
        verification=$2
        validate_verification "$verification"
        case "$kind" in
            native) build_native "$verification" ;;
            distribution) build_distribution "$verification" "$3" ;;
            *) echo "blckbaux: unknown build kind: $kind" >&2; exit 1 ;;
        esac
        ;;
    test)
        case "$1" in
            all) test_repository ;;
            affected) test_affected ;;
            *) echo "blckbaux: unknown test scope: $1" >&2; exit 1 ;;
        esac
        ;;
    radar) exec tools/ripwirew "$@" ;;
    *) echo "blckbaux: unknown internal developer action: $action" >&2; exit 1 ;;
esac
