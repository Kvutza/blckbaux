#!/bin/sh
set -eu

repo_dir=${PIXI_PROJECT_ROOT:-}
if [ -z "$repo_dir" ]; then
    repo_dir=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
fi

adapter_path="$repo_dir/tools/kiss"
upstream=${KISS_UPSTREAM_BIN:-}
if [ -z "$upstream" ]; then
    upstream=$(command -v kiss || true)
    if [ "$upstream" = "$adapter_path" ]; then
        saved_path=$PATH
        PATH=$(printf '%s\n' "$PATH" | tr ':' '\n' | awk -v skip="$repo_dir/tools" '$0 != skip' | paste -sd: -)
        upstream=$(command -v kiss || true)
        PATH=$saved_path
    fi
fi

if [ -z "$upstream" ] || [ "$upstream" = "$adapter_path" ]; then
    echo "blckbaux: upstream KISS executable not found; set KISS_UPSTREAM_BIN" >&2
    exit 127
fi

command_name=
lang=
config_file="$repo_dir/.config/kiss.toml"
custom_config=0
previous=
for arg in "$@"; do
    case "$arg" in
        check|stats|dry|viz|rules|test) command_name=$arg ;;
        --lang=*) lang=${arg#--lang=} ;;
        --config=*) config_file=${arg#--config=}; custom_config=1 ;;
    esac
    if [ "$previous" = "--lang" ]; then
        lang=$arg
    elif [ "$previous" = "--config" ]; then
        config_file=$arg
        custom_config=1
    fi
    previous=$arg
done

if [ -n "$command_name" ] && [ ! -f "$config_file" ]; then
    echo "blckbaux: KISS configuration not found: $config_file" >&2
    exit 2
fi

if [ "$command_name" != test ]; then
    if [ "$custom_config" -eq 0 ]; then
        set -- --config "$config_file" "$@"
    fi
    ignored_files=
    case "$command_name" in
        check|stats|dry|viz)
            ignore_file="$repo_dir/.config/kiss.ignore"
            if [ ! -f "$ignore_file" ]; then
                echo "blckbaux: KISS ignore file not found: $ignore_file" >&2
                exit 2
            fi
            while IFS= read -r prefix || [ -n "$prefix" ]; do
                case "$prefix" in
                    ''|'#'*) continue ;;
                esac
                prefix=${prefix%/}
                if [ -d "$repo_dir/$prefix" ]; then
                    set -- "$@" --ignore "$prefix"
                elif [ "$command_name" = check ]; then
                    ignored_files="${ignored_files}${ignored_files:+
}$repo_dir/$prefix"
                fi
            done < "$ignore_file"
            ;;
    esac
    if [ "$command_name" = check ] && [ -n "$ignored_files" ]; then
        output=$(mktemp)
        kiss_status=0
        "$upstream" "$@" >"$output" 2>&1 || kiss_status=$?
        filtered=$(mktemp)
        trap 'rm -f "$output" "$filtered"' EXIT HUP INT TERM
        printf '%s\n' "$ignored_files" | awk '
            NR == FNR { ignored[NR] = $0; count = NR; next }
            /^VIOLATION:/ {
                for (i = 1; i <= count; i++)
                    if (index($0, ":" ignored[i] ":")) next
            }
            { print }
        ' - "$output" >"$filtered"
        cat "$filtered"
        if grep -q '^VIOLATION:' "$filtered"; then
            exit 1
        fi
        if [ "$kiss_status" -ne 0 ] && ! grep -q '^VIOLATION:' "$output"; then
            exit "$kiss_status"
        fi
        exit 0
    fi
    exec "$upstream" "$@"
fi

case "$lang" in
    python|py)
        if [ "$custom_config" -eq 0 ]; then
            set -- --config "$config_file" "$@"
        fi
        exec "$upstream" "$@"
        ;;
    rust|rs|"")
        ;;
    *)
        echo "blckbaux: unsupported KISS language: $lang" >&2
        exit 2
        ;;
esac

if [ "${1:-}" = test ]; then
    shift
fi

dry_run=0
jobs=
target=
has_passthrough=0

while [ "$#" -gt 0 ]; do
    case "$1" in
        test)
            shift
            ;;
        --)
            has_passthrough=1
            shift
            break
            ;;
        --help|-h)
            cat <<'EOF'
Usage: kiss test [--lang rust|python] [--dry-run] [-j JOBS] [-- ARGS...]

Rust tests run through Buck2 at //build/buck2/tests:all. Python tests are delegated
to the upstream KISS executable.
EOF
            exit 0
            ;;
        --lang)
            shift 2
            ;;
        --lang=*)
            shift
            ;;
        --config=*)
            shift
            ;;
        --config|--main-branch|--base-branch|--ignore)
            shift 2
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -j|--jobs)
            jobs=$2
            shift 2
            ;;
        -j*)
            jobs=${1#-j}
            shift
            ;;
        --jobs=*)
            jobs=${1#--jobs=}
            shift
            ;;
        --metrics|--coverage-all|--retry-bad|--watch)
            echo "blckbaux: KISS option $1 is not applicable to Buck2 Rust tests" >&2
            exit 2
            ;;
        .)
            shift
            ;;
        -*)
            echo "blckbaux: unsupported KISS Rust-test option: $1" >&2
            exit 2
            ;;
        *)
            if [ -n "$target" ]; then
                echo "blckbaux: Buck2 adapter accepts only the repository Rust test target" >&2
                exit 2
            fi
            target=$1
            shift
            ;;
    esac
done

if [ -n "$target" ] && [ "$target" != "." ]; then
    echo "blckbaux: KISS target '$target' has no Buck2 mapping; use ./buck2w test directly" >&2
    exit 2
fi

if [ "$dry_run" -eq 1 ]; then
    exec "$repo_dir/buck2w" targets //build/buck2/tests:all
fi

if [ -n "$jobs" ] && [ "$has_passthrough" -eq 1 ]; then
    exec "$repo_dir/buck2w" test //build/buck2/tests:all --local-only -j "$jobs" -- "$@"
elif [ -n "$jobs" ]; then
    exec "$repo_dir/buck2w" test //build/buck2/tests:all --local-only -j "$jobs"
elif [ "$has_passthrough" -eq 1 ]; then
    exec "$repo_dir/buck2w" test //build/buck2/tests:all --local-only -- "$@"
else
    exec "$repo_dir/buck2w" test //build/buck2/tests:all --local-only
fi
