load("//buck2:blckbaux_targets.bzl", "blckbaux_program_targets")
load("//build:targets.bzl", "CLI_CRATES", "CLI_PROGRAMS", "RUST_EDITION")

filegroup(
    name = "source",
    srcs = glob(["src/**"]) + ["Cargo.toml"],
    visibility = ["PUBLIC"],
)

blckbaux_program_targets(CLI_PROGRAMS, RUST_EDITION, glob(["src/**/*.rs"]))

rust_test(
    name = "blckbaux-test",
    srcs = glob(["src/**/*.rs"]),
    crate = "blckbaux_cli_test",
    crate_root = [program["root"] for program in CLI_PROGRAMS if program["name"] == "blckbaux"][0],
    env = {"CARGO_PKG_VERSION": [program["version"] for program in CLI_PROGRAMS if program["name"] == "blckbaux"][0]},
    edition = RUST_EDITION,
    deps = ["//rust:" + crate for crate in CLI_CRATES] + [
        "//rust/crates/tooling:tooling",
        "//rust/crates/artifact:artifact",
    ],
    visibility = ["//buck2/tests:all"],
)
