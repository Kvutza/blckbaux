#include <metal_stdlib>
#include <MetalPerformancePrimitives/MPPTensorOpsMatMul2d.h>
using namespace metal;
using namespace mpp::tensor_ops;

// ABI records and layout assertions are generated by blckbaux_semantics::hnet.
// All positions are generated-relative.
METAL_FUNC ulong hnet_mix(ulong x) {
    x += 0x9e3779b97f4a7c15ul;
    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ul;
    x = (x ^ (x >> 27)) * 0x94d049bb133111ebul;
    return x ^ (x >> 31);
}

// A diagonal stable state-space transition. The local position coordinate is
// also the learned transition logit, so this adds no parameters. At zero the
// retention is 0.75; the complementary input coefficient preserves variance.
METAL_FUNC float hnet_retention(float coordinate) {
    const float value = coordinate + 1.0986122886681098f;
    const float e = exp(-abs(value));
    return value >= 0.0f ? 1.0f / (1.0f + e) : e / (1.0f + e);
}

METAL_FUNC float hnet_input_scale(float retention) {
    return sqrt(max(1.0f - retention * retention, 1e-6f));
}

// 8^6 is the exact vocabulary. Every non-leaf node is the normalized sum of
// the tied token readouts below it.
kernel void hnet_hierarchy_centroids(
    device const half* readout [[buffer(0)]],
    device half* centroids [[buffer(1)]],
    constant WaveShape& p [[buffer(2)]],
    uint gid [[thread_position_in_grid]]) {
    const uint dimensions = 64;
    const uint nodes = 37448;
    const uint elements = nodes * dimensions;
    if (gid >= elements) return;
    const uint node = gid / dimensions;
    const uint dimension = gid % dimensions;
    uint offset, leaves;
    if (node < 8) { offset = 0; leaves = 32768; }
    else if (node < 72) { offset = 8; leaves = 4096; }
    else if (node < 584) { offset = 72; leaves = 512; }
    else if (node < 4680) { offset = 584; leaves = 64; }
    else { offset = 4680; leaves = 8; }
    const uint local = node - offset;
    const uint first = local * leaves;
    float value = 0.0f;
    for (uint token = 0; token < leaves; ++token)
        value += float(readout[ulong(dimension) * p.vocabulary + first + token]);
    centroids[ulong(node) * dimensions + dimension] = half(value * rsqrt(float(leaves)));
}

METAL_FUNC uint hnet_level_offset(uint level) {
    constexpr uint offsets[5] = {0, 8, 72, 584, 4680};
    return offsets[level];
}

kernel void hnet_hierarchical_expand(
    device const half* hidden [[buffer(0)]], device const half* qkv [[buffer(1)]],
    device const half* positions [[buffer(2)]], device const half* readout [[buffer(3)]],
    device const half* centroids [[buffer(4)]], device const ulong* seed [[buffer(5)]],
    device const uint* expected [[buffer(6)]], device uint* output [[buffer(7)]],
    device float* losses [[buffer(8)]], constant WaveShape& p [[buffer(9)]],
    uint block [[threadgroup_position_in_grid]],
    uint lane [[thread_index_in_simdgroup]],
    uint branch [[simdgroup_index_in_threadgroup]]) {
    const uint first = block * 64;
    if (first >= p.tokens) return;
    threadgroup half query[2][64];
    threadgroup float base[64];
    threadgroup float prefix[2][64];
    threadgroup float logits[2][8];
    threadgroup float sampled[8];
    threadgroup uint selected;
    threadgroup float token_loss;
    // Two SIMD groups own a patch: one advances the sampled trajectory while
    // the other advances the reference trajectory used by conditional NLL.
    // Their independent dot products execute concurrently.
    for (uint dimension = lane; dimension < 64; dimension += 32) {
        if (branch == 0) {
            float value = 0.0f;
            for (uint k = 0; k < 512; ++k)
                value = fma(float(hidden[ulong(p.proposal_start + block) * 512 + k]),
                            float(qkv[ulong(k) * 640 + dimension]), value);
            base[dimension] = value * 0.0441941738f;
        }
        prefix[branch][dimension] = 0.0f;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);

    for (uint intra = 0; intra < 64; ++intra) {
        const uint position = first + intra;
        const bool active = position < p.tokens;
        if (!active) break;
        for (uint dimension = lane; dimension < 64; dimension += 32) {
            query[branch][dimension] = half(
                base[dimension]
                + float(positions[ulong(intra) * 512 + dimension])
                + prefix[branch][dimension]);
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        if (branch == 0 && lane == 0) {
            selected = 0;
            token_loss = 0.0f;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        const uint target_token = p.score != 0 ? expected[position] : 0;
        const uint child = lane >> 2;
        const uint child_lane = lane & 3u;
        for (uint level = 0; level < 6; ++level) {
            // Four lanes own one child. The two SIMD groups evaluate sampled
            // and reference prefixes at the same time.
            const uint parent = branch != 0
                ? target_token >> ((6 - level) * 3)
                : selected;
            const uint index = parent * 8 + child;
            float value = 0.0f;
            if (level < 5) {
                const uint node = hnet_level_offset(level) + index;
                threadgroup const half4* query4 =
                    reinterpret_cast<threadgroup const half4*>(query[branch]);
                device const half4* centroid4 = reinterpret_cast<device const half4*>(
                    centroids + ulong(node) * 64);
                for (uint vector = child_lane; vector < 16; vector += 4)
                    value += dot(float4(query4[vector]), float4(centroid4[vector]));
            } else {
                for (uint d = child_lane; d < 64; d += 4)
                    value = fma(float(query[branch][d]),
                                float(readout[ulong(d) * p.vocabulary + index]), value);
            }
            value += simd_shuffle_down(value, 2);
            value += simd_shuffle_down(value, 1);
            if (child_lane == 0) logits[branch][child] = value;
            if (branch == 0 && child_lane == 0) {
                float choice = value;
                if (p.temperature > 0.0f) {
                    const ulong key = (ulong(level) << 56) ^ ulong(index);
                    const ulong bits = hnet_mix(seed[0] ^ (ulong(position) << 32) ^ key);
                    const float u = (float(uint(bits >> 41)) + 0.5f) / 8388608.0f;
                    choice -= p.temperature * log(-log(u));
                }
                sampled[child] = choice;
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
            if (branch == 0 && lane == 0) {
                uint choice = 0;
                for (uint child = 1; child < 8; ++child)
                    if (sampled[child] > sampled[choice]) choice = child;
                selected = selected * 8 + choice;
                if (p.score) {
                    float maximum = logits[1][0];
                    for (uint child = 1; child < 8; ++child)
                        maximum = max(maximum, logits[1][child]);
                    float sum = 0.0f;
                    for (uint child = 0; child < 8; ++child)
                        sum += exp(logits[1][child] - maximum);
                    const uint target_child = (target_token >> ((5 - level) * 3)) & 7u;
                    token_loss += maximum + log(sum) - logits[1][target_child];
                }
            }
            threadgroup_barrier(mem_flags::mem_threadgroup);
        }
        if (branch == 0 && lane == 0) {
            output[position] = selected;
            if (p.score) losses[position] = token_loss;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (uint dimension = lane; dimension < 64; dimension += 32) {
            const uint token = branch == 0 ? selected : target_token;
            const float retention = hnet_retention(
                float(positions[ulong(intra) * 512 + dimension]));
            prefix[branch][dimension] = fma(retention,
                prefix[branch][dimension], hnet_input_scale(retention)
                    * float(readout[ulong(dimension) * p.vocabulary + token]));
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
}

kernel void hnet_wave_init(
    device const half* hidden [[buffer(0)]], device const half* qkv [[buffer(1)]],
    device const half* positions [[buffer(2)]], device float* base [[buffer(3)]],
    device float* prefix [[buffer(4)]], device half* query [[buffer(5)]],
    constant WaveShape& p [[buffer(6)]], uint gid [[thread_position_in_grid]]) {
    if (gid >= p.blocks * 64) return;
    uint b = gid / 64, d = gid % 64;
    float value = 0.0f;
    for (uint k = 0; k < 512; ++k)
        value += float(hidden[ulong(p.proposal_start + b) * 512 + k]) * float(qkv[ulong(k) * 640 + d]);
    base[gid] = value * 0.0441941738f;
    prefix[gid] = 0.0f;
    query[gid] = half(base[gid] + float(positions[d]));
}

// M32/N128/K64. FP32 logits exist only in this 16KiB threadgroup tile.
kernel void hnet_wave_project(
    device half* query [[buffer(0)]], device half* weights [[buffer(1)]],
    device const ulong* seed [[buffer(2)]], device const uint* expected [[buffer(3)]],
    device ShardStats* partials [[buffer(4)]], constant WaveShape& p [[buffer(5)]],
    uint2 group [[threadgroup_position_in_grid]], uint tid [[thread_index_in_threadgroup]]) {
    threadgroup float logits[32 * 128];
    constexpr auto descriptor = matmul2d_descriptor(32, 128, 64);
    matmul2d<descriptor, execution_simdgroups<4>> op;
    uint first = group.y * 32, column = group.x * 128;
    uint rows = min(32u, p.blocks - first);
    auto a = tensor(query + ulong(first) * 64, dextents<int32_t,2>{64, int32_t(rows)});
    auto b = tensor(weights + column, extents<int32_t,128,64>{}, array<int32_t,2>{1,int32_t(p.vocabulary)});
    auto c = tensor(logits, dextents<int32_t,2>{128, int32_t(rows)});
    auto values = op.template get_destination_cooperative_tensor<decltype(a),decltype(b),float>();
    op.run(a,b,values);
    values.store(c);
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid >= rows) return;
    uint block = first + tid, pos = block * 64 + p.intra;
    if (pos >= p.tokens) return;
    float maximum = -INFINITY, sum = 0.0f, target = -INFINITY, best = -INFINITY;
    uint chosen = UINT_MAX;
    for (uint v = 0; v < 128; ++v) maximum = max(maximum, logits[tid * 128 + v]);
    for (uint v = 0; v < 128; ++v) {
        uint token = column + v;
        float logit = logits[tid * 128 + v];
        float weight = exp(logit - maximum);
        float next_sum = sum + weight;
        if (p.score && expected[pos] == token) target = logit;
        float sample = logit;
        if (p.temperature > 0.0f) {
            ulong bits = hnet_mix(seed[0] ^ (ulong(pos) << 32) ^ ulong(token));
            float u = (float(uint(bits >> 41)) + 0.5f) / 8388608.0f;
            sample -= p.temperature * log(-log(u));
        }
        if (sample > best || (sample == best && token < chosen)) {
            best = sample; chosen = token;
        }
        sum = next_sum;
    }
    partials[ulong(block) * p.shards + group.x] = ShardStats{maximum,sum,target,best,chosen,0};
}

// Merge all vocabulary shards, publish one token/loss, and form the next query.
kernel void hnet_wave_reduce(
    device const ShardStats* partials [[buffer(0)]], device const float* base [[buffer(1)]],
    device float* prefix [[buffer(2)]], device half* query [[buffer(3)]],
    device const half* positions [[buffer(4)]], device const half* readout [[buffer(5)]],
    device uint* output [[buffer(6)]], device float* losses [[buffer(7)]],
    device const ulong* seed [[buffer(8)]], constant WaveShape& p [[buffer(9)]],
    uint block [[threadgroup_position_in_grid]],
    uint tid [[thread_index_in_threadgroup]]) {
    if (block * 64 + p.intra >= p.tokens) return;
    threadgroup ShardStats tree[256];
    ShardStats local = ShardStats{-INFINITY, 0.0f, -INFINITY, -INFINITY, UINT_MAX, 0};
    for (uint shard = tid; shard < p.shards; shard += 256) {
        ShardStats other = partials[ulong(block) * p.shards + shard];
        if (other.sum > 0.0f) {
            if (local.sum == 0.0f) { local.maximum = other.maximum; local.sum = other.sum; }
            else {
                float maximum = max(local.maximum, other.maximum);
                local.sum = local.sum * exp(local.maximum - maximum) + other.sum * exp(other.maximum - maximum);
                local.maximum = maximum;
            }
        }
        local.target = max(local.target, other.target);
        if (other.best > local.best || (other.best == local.best && other.token < local.token)) {
            local.best = other.best; local.token = other.token;
        }
    }
    tree[tid] = local;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            ShardStats a = tree[tid], b = tree[tid + stride];
            if (b.sum > 0.0f) {
                if (a.sum == 0.0f) { a.maximum = b.maximum; a.sum = b.sum; }
                else {
                    float maximum = max(a.maximum, b.maximum);
                    a.sum = a.sum * exp(a.maximum - maximum) + b.sum * exp(b.maximum - maximum);
                    a.maximum = maximum;
                }
            }
            a.target = max(a.target, b.target);
            if (b.best > a.best || (b.best == a.best && b.token < a.token)) {
                a.best = b.best; a.token = b.token;
            }
            tree[tid] = a;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (tid == 0) {
        ShardStats s = tree[0];
        output[ulong(block) * 64 + p.intra] = s.token;
        if (p.score) losses[ulong(block) * 64 + p.intra] = s.maximum + log(s.sum) - s.target;
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    if (tid < 64 && p.intra + 1 < 64) {
        ulong idx = ulong(block) * 64 + tid;
        uint chosen = output[ulong(block) * 64 + p.intra];
        const float retention = hnet_retention(
            float(positions[ulong(p.intra) * 512 + tid]));
        float value = fma(retention, prefix[idx], hnet_input_scale(retention)
            * float(readout[ulong(tid) * p.vocabulary + chosen]));
        prefix[idx] = value;
        query[idx] = half(base[idx]
            + float(positions[ulong(p.intra + 1) * 512 + tid]) + value);
    }
}
