load("@crates//:defs.bzl", "aliases", "crate_edition")
load("@rules_rust//rust:defs.bzl", "rust_shared_library")
load("//:bazel/python_extension.bzl", "copy_extension")
load("//build:targets.bzl", "BLCKBAUX_PY_CRATES")
load("//rust/crates/blckbaux:defs.bzl", "blckbaux_crate_deps")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

BLCKBAUX_PY_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/blckbaux_py_build.rs"],
)

BLCKBAUX_PY_DEPS = blckbaux_crate_deps(BLCKBAUX_PY_CRATES)

PYO3_LINK_FLAGS = select({
    "@platforms//os:macos": [
        "-Clink-arg=-undefined",
        "-Clink-arg=dynamic_lookup",
    ],
    "//conditions:default": [],
})

rust_shared_library(
    name = "blckbaux_rust_cpu",
    srcs = BLCKBAUX_PY_SRCS,
    aliases = aliases(),
    crate_features = ["usearch-native"],
    crate_name = "blckbaux_rust",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "rust/crates/blckbaux-py",
    },
    rustc_flags = PYO3_LINK_FLAGS,
    deps = BLCKBAUX_PY_DEPS + [
        "//rust/crates/blckbaux:blckbaux_cpu",
    ],
)

rust_shared_library(
    name = "blckbaux_rust_metal",
    srcs = BLCKBAUX_PY_SRCS,
    aliases = aliases(),
    crate_features = [
        "metal",
        "usearch-native",
    ],
    crate_name = "blckbaux_rust",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "rust/crates/blckbaux-py",
    },
    rustc_flags = PYO3_LINK_FLAGS,
    target_compatible_with = ["@platforms//os:macos"],
    deps = BLCKBAUX_PY_DEPS + [
        "//rust/crates/blckbaux:blckbaux_metal",
        "@crates//:metal",
    ],
)

rust_shared_library(
    name = "blckbaux_rust_opencl",
    srcs = BLCKBAUX_PY_SRCS,
    aliases = aliases(),
    crate_features = [
        "opencl",
        "usearch-native",
    ],
    crate_name = "blckbaux_rust",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "rust/crates/blckbaux-py",
    },
    rustc_flags = PYO3_LINK_FLAGS,
    deps = BLCKBAUX_PY_DEPS + [
        "//rust/crates/blckbaux:blckbaux_opencl",
    ],
)

alias(
    name = "blckbaux_rust",
    actual = select({
        "@platforms//os:linux": ":blckbaux_rust_opencl",
        "@platforms//os:macos": ":blckbaux_rust_metal",
        "//conditions:default": ":blckbaux_rust_cpu",
    }),
)

copy_extension(
    name = "python_extension",
    src = ":blckbaux_rust",
    output = "blckbaux_rust.so",
)
