     1066:     #[test]
     1067:     fn response_trajectory_matches_metal_device() {
     1068:         use crate::Perturbation;
     1069:         use crate::bf16_metal::{ParamBlock, ProgramAddress, SearchState};
     1070:         use crate::config::{DistanceScaling, HistoryGeometry, ResidentEnnConfig};
     1071:         use crate::procedural_pool::{ProceduralPool, ProposalMethod};
     1072:         use crate::trials::Ask;
     1073:         use crate::trust_region::TRLengthConfig;
     1074:         use crate::weights::AcquisitionKind;
     1075:         use metal::objc::rc::autoreleasepool;
     1076:
     1077:         fn fp16_bits(value: f32) -> u16 {
     1078:             let bits = value.to_bits();
     1079:             let sign = ((bits >> 16) & 0x8000) as u16;
     1080:             let exponent = ((bits >> 23) & 0xff) as i32;
     1081:             let fraction = bits & 0x7f_ffff;
     1082:             if exponent == 0xff {
     1083:                 return sign | 0x7c00 | u16::from(fraction != 0);
     1084:             }
     1085:             let mut half_exponent = exponent - 127 + 15;
     1086:             if half_exponent >= 31 {
     1087:                 return sign | 0x7c00;
     1088:             }
     1089:             if half_exponent <= 0 {
     1090:                 if half_exponent < -10 {
     1091:                     return sign;
     1092:                 }
     1093:                 let mantissa = fraction | 0x80_0000;
     1094:                 let shift = (14 - half_exponent) as u32;
     1095:                 let mut rounded = mantissa >> shift;
     1096:                 let remainder = mantissa & ((1u32 << shift) - 1);
     1097:                 let halfway = 1u32 << (shift - 1);
     1098:                 if remainder > halfway || (remainder == halfway && rounded & 1 != 0) {
     1099:                     rounded += 1;
     1100:                 }
     1101:                 return sign | rounded as u16;
     1102:             }
     1103:             let mut rounded = fraction >> 13;
     1104:             let remainder = fraction & 0x1fff;
     1105:             if remainder > 0x1000 || (remainder == 0x1000 && rounded & 1 != 0) {
     1106:                 rounded += 1;
     1107:                 if rounded == 0x400 {
     1108:                     rounded = 0;
     1109:                     half_exponent += 1;
     1110:                     if half_exponent == 31 {
     1111:                         return sign | 0x7c00;
     1112:                     }
     1113:                 }
     1114:             }
     1115:             sign | ((half_exponent as u16) << 10) | rounded as u16
     1116:         }
     1117:
     1118:         fn fp16(bits: u16) -> f32 {
     1119:             let exponent = (bits >> 10) & 31;
     1120:             let fraction = f32::from(bits & 1023);
     1121:             let magnitude = match exponent {
     1122:                 0 => fraction * 2.0f32.powi(-24),
     1123:                 31 => f32::NAN,
     1124:                 _ => (1024.0 + fraction) * 2.0f32.powi(i32::from(exponent) - 25),
     1125:             };
     1126:             if bits & 0x8000 == 0 {
     1127:                 magnitude
     1128:             } else {
     1129:                 -magnitude
     1130:             }
     1131:         }
     1132:
     1133:         autoreleasepool(|| {
     1134:             let families = 0..17usize;
     1135:             let block_len = 64usize;
     1136:             let base = vec![fp16_bits(0.25); 17 * block_len];
     1137:             let blocks = families
     1138:                 .map(|family| {
     1139:                     ParamBlock::new_logical(
     1140:                         crate::hash::tensor_key(&format!("response-family-{family}")),
     1141:                         0,
     1142:                         family * block_len,
     1143:                         block_len,
     1144:                         0.125,
     1145:                         1.0 / (block_len as f32 * 0.125f32.powi(2)),
     1146:                     )
     1147:                     .unwrap()
     1148:                     .with_address(ProgramAddress::new(family, Some(0), None).unwrap())
     1149:                 })
     1150:                 .collect::<Vec<_>>();
     1151:             let mut metal = SearchState::new_implicit(
     1152:                 &base,
     1153:                 blocks.clone(),
     1154:                 1,
     1155:                 TRLengthConfig::new(0.1, 0.1, 2.0),
     1156:                 Perturbation::Gaussian,
     1157:             )
     1158:             .unwrap();
     1159:             metal
     1160:                 .configure_enn(ResidentEnnConfig {
     1161:                     pool: ProceduralPool::legacy(),
     1162:                     proposal_method: ProposalMethod::Posterior,
     1163:                     ask: Ask {
     1164:                         neighbors: 1,
     1165:                         epistemic_scale: 0.05,
     1166:                         aleatoric_scale: 0.05,
     1167:                         y_scale: 1.0,
     1168:                         acquisition: AcquisitionKind::Thompson,
     1169:                         seed: 0x1234_5678_9abc_def0,
     1170:                         ..Ask::default()
     1171:                     },
     1172:                     num_candidates: 4,
     1173:                     num_samples: 4,
     1174:                     fit_neighbors: false,
     1175:                     distance_scaling: DistanceScaling::Global,
     1176:                     history_geometry: HistoryGeometry::Latent,
     1177:                     local_scale_neighbors: 8,
     1178:                 })
     1179:                 .unwrap();
     1180:             metal
     1181:                 .configure_controller(crate::reliability_region::ReliabilityPolicy::default())
     1182:                 .unwrap();
     1183:             metal.observe_initial(0.0, 0.0).unwrap();
     1184:
     1185:             let mut host = ResponsePosterior::new();
     1186:             let host_incumbent = EnnHistory::new(0.0, 0.0, 0x1234_5678_9abc_def0)
     1187:                 .unwrap()
     1188:                 .incumbent_prediction();
     1189:             for round in 0..8usize {
     1190:                 let root = 0x6a09_e667_f3bc_c909_u64 + round as u64;
     1191:                 let host_pool = host.pool(
     1192:                     root,
     1193:                     Acquisition::Thompson,
     1194:                     if round == 0 {
     1195:                         host_incumbent
     1196:                     } else {
     1197:                         Prediction::default()
     1198:                     },
     1199:                 );
     1200:                 let expected = ResponsePosterior::select(&host_pool);
     1201:                 let ask = Ask {
     1202:                     neighbors: 1,
     1203:                     epistemic_scale: 0.05,
     1204:                     aleatoric_scale: 0.05,
     1205:                     y_scale: 1.0,
     1206:                     acquisition: AcquisitionKind::Thompson,
     1207:                     seed: 0xbb67_ae85_84ca_a73b + round as u64,
     1208:                     ..Ask::default()
     1209:                 };
     1210:                 let proposal = metal.ask_round(1, 4, root, ask).unwrap();
     1211:                 assert_eq!(proposal.index, expected);
     1212:                 assert_eq!(proposal.seed, host_pool[expected].seed);
     1213:                 assert!((proposal.score - host_pool[expected].score).abs() <= 2.0e-5);
     1214:                 assert!(
     1215:                     (proposal.response_mean - host_pool[expected].response_mean).abs() <= 2.0e-5
     1216:                 );
     1217:                 assert!(
     1218:                     (proposal.response_variance - host_pool[expected].response_variance).abs()
     1219:                         <= 2.0e-5
     1220:                 );
     1221:
     1222:                 if round == 0 {
     1223:                     assert_eq!(
     1224:                         proposal.incumbent_mean.to_bits(),
     1225:                         host_incumbent.mean.to_bits()
     1226:                     );
     1227:                     assert_eq!(
     1228:                         proposal.incumbent_standard_error.to_bits(),
     1229:                         host_incumbent.standard_error.to_bits()
     1230:                     );
     1231:                     assert!(
     1232:                         (proposal.predicted_mean - host_pool[expected].prediction.mean).abs()
     1233:                             <= 2.0e-5
     1234:                     );
     1235:                     assert!(
     1236:                         (proposal.predicted_standard_error
     1237:                             - host_pool[expected].prediction.standard_error)
     1238:                             .abs()
     1239:                             <= 2.0e-5
     1240:                     );
     1241:                     let actual = super::super::layout::read::<u16>(&metal.proposal, base.len());
     1242:                     let tables = ziggurat_tables();
     1243:                     for block in &blocks {
     1244:                         let group = usize::from(block.address.bits() & 31);
     1245:                         for element in 0..block.len {
     1246:                             let field = fp16(fp16_bits(normal(
     1247:                                 BASIS_SEED ^ 0x7265_7370_6669_656c,
     1248:                                 block.key,
     1249:                                 element as u64,
     1250:                                 &tables,
     1251:                             )));
     1252:                             let direction = response_feature(
     1253:                                 host_pool[expected].coefficients[group]
     1254:                                     + host_pool[expected].uncertainty[group]
     1255:                                         * response_sign(
     1256:                                             host_pool[expected].seed,
     1257:                                             block.key,
     1258:                                             element as u64,
     1259:                                         ),
     1260:                             ) * field;
     1261:                             let expected_bits =
     1262:                                 fp16_bits(0.25 + block.scale * proposal.length * direction);
     1263:                             assert_eq!(actual[block.offset + element], expected_bits);
     1264:                         }
     1265:                     }
     1266:                 }
     1267:
     1268:                 let responses = (0..64)
     1269:                     .map(|channel| {
     1270:                         ((round * 17 + channel * 11 + expected * 3) % 37) as f32 * 0.001 - 0.018
     1271:                     })
     1272:                     .collect::<Vec<_>>();
     1273:                 let mean = responses.iter().sum::<f32>() / responses.len() as f32;
     1274:                 let variance = responses
     1275:                     .iter()
     1276:                     .map(|value| (value - mean).powi(2))
     1277:                     .sum::<f32>()
     1278:                     / ((responses.len() - 1) * responses.len()) as f32;
     1279:                 let incumbent = metal.best().unwrap();
     1280:                 let incumbent_variance = metal.best_variance().unwrap();
     1281:                 metal
     1282:                     .paired_blocks(
     1283:                         &proposal,
     1284:                         incumbent + mean,
     1285:                         incumbent_variance + variance,
     1286:                         incumbent,
     1287:                         incumbent_variance,
     1288:                         mean,
     1289:                         variance,
     1290:                         &responses,
     1291:                     )
     1292:                     .unwrap();
     1293:                 metal.sync().unwrap();
     1294:                 host.observe(&host_pool[expected], &responses).unwrap();
     1295:             }
     1296:         });
     1297:     }
