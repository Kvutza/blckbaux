     1313:         .unwrap();
     1314:         for step in 0..48 {
     1315:             let observed = (step as f32 * 0.017).sin() * 0.2;
     1316:             let observed_variance = 0.002 + (step % 5) as f32 * 0.0005;
     1317:             let predicted = (step as f32 * 0.011).cos() * 0.15;
     1318:             let predicted_variance = 0.003 + (step % 7) as f32 * 0.0004;
     1319:             let response_radius = 0.03 + (step % 4) as f32 * 0.01;
     1320:             let before = cuda.radius();
     1321:             let accepted = observed > cuda.calibration.multiplier() * observed_variance.sqrt();
     1322:             let cuda_decision = cuda.observe(
     1323:                 observed,
     1324:                 observed_variance,
     1325:                 predicted,
     1326:                 predicted_variance,
     1327:                 response_radius,
     1328:                 false,
     1329:             );
     1330:             let metal_telemetry = metal
     1331:                 .update(ReliabilityEvidence {
     1332:                     observed_improvement: f64::from(observed),
