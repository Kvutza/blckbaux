      518: #[derive(Clone, Debug)]
      519: pub(super) struct ResponseField {
      520:     mean: Vec<f32>,
      521:     variance: Vec<f32>,
      522:     observations: Vec<u32>,
      523:     active: [bool; RESPONSE_GROUPS],
      524:     prior_variance: f32,
      525: }
      526:
      527: impl ResponseField {
      528:     pub(super) fn new(active: [bool; RESPONSE_GROUPS], prior_variance: f32) -> Self {
      529:         Self {
      530:             mean: Vec::new(),
      531:             variance: Vec::new(),
      532:             observations: Vec::new(),
      533:             active,
      534:             prior_variance,
      535:         }
      536:     }
      537:
      538:     fn ensure_channels(&mut self, channels: usize) {
      539:         while self.observations.len() < channels {
      540:             self.observations.push(0);
      541:             self.mean.extend([0.0; RESPONSE_GROUPS]);
      542:             self.variance.extend(
      543:                 self.active
      544:                     .map(|active| if active { self.prior_variance } else { 0.0 }),
      545:             );
      546:         }
      547:     }
      548:
      549:     pub(super) fn observe(&mut self, responses: &[f32], features: &[f32; RESPONSE_GROUPS]) {
      550:         self.ensure_channels(responses.len());
      551:         let response_mean = responses.iter().sum::<f32>() / responses.len() as f32;
      552:         let noise = if responses.len() > 1 {
      553:             responses
      554:                 .iter()
      555:                 .map(|value| (value - response_mean).powi(2))
      556:                 .sum::<f32>()
      557:                 / (responses.len() - 1) as f32
      558:         } else {
      559:             f32::EPSILON
      560:         }
      561:         .max(1.0e-10);
      562:         for (channel, &observed) in responses.iter().enumerate() {
      563:             let start = channel * RESPONSE_GROUPS;
      564:             let means = &mut self.mean[start..start + RESPONSE_GROUPS];
      565:             let variances = &mut self.variance[start..start + RESPONSE_GROUPS];
      566:             let predicted = means
      567:                 .iter()
      568:                 .zip(features)
      569:                 .map(|(mean, feature)| mean * feature)
      570:                 .sum::<f32>();
      571:             let denominator = (noise
      572:                 + variances
      573:                     .iter()
      574:                     .zip(features)
      575:                     .map(|(variance, feature)| variance * feature * feature)
      576:                     .sum::<f32>())
      577:             .max(1.0e-20);
      578:             let innovation = observed - predicted;
      579:             for group in 0..RESPONSE_GROUPS {
      580:                 if !self.active[group] {
      581:                     continue;
      582:                 }
      583:                 let variance = variances[group];
      584:                 let feature = features[group];
      585:                 let gain = variance * feature / denominator;
      586:                 means[group] += gain * innovation;
      587:                 variances[group] = (variance - gain * feature * variance).max(1.0e-30);
      588:             }
      589:             self.observations[channel] = self.observations[channel].saturating_add(1);
      590:         }
      591:     }
      592:
      593:     pub(super) fn aggregate(&self) -> ([f32; RESPONSE_GROUPS], [f32; RESPONSE_GROUPS]) {
      594:         let mut means = [0.0; RESPONSE_GROUPS];
      595:         let mut variances = [0.0; RESPONSE_GROUPS];
      596:         let channels = self
      597:             .observations
      598:             .iter()
      599:             .rposition(|count| *count > 0)
      600:             .map_or(0, |index| index + 1);
      601:         if channels == 0 {
      602:             return (means, variances);
      603:         }
      604:         for channel in 0..channels {
      605:             let start = channel * RESPONSE_GROUPS;
      606:             for group in 0..RESPONSE_GROUPS {
      607:                 means[group] += self.mean[start + group];
      608:                 variances[group] += self.variance[start + group];
      609:             }
      610:         }
      611:         for group in 0..RESPONSE_GROUPS {
      612:             means[group] /= channels as f32;
      613:             variances[group] /= channels as f32;
      614:         }
      615:         (means, variances)
      616:     }
      617: }
