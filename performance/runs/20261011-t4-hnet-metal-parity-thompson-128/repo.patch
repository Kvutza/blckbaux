      865:             accepted: observed_improvement > threshold,
      866:             improvement: f64::from(observed_improvement),
      867:             threshold: f64::from(threshold),
      868:             predicted_improvement: f64::from(predicted_improvement),
      869:             action: ReliabilityAction::Hold,
      870:             next_radius: self.radius(),
      871:             standardized_error: 0.0,
      872:             sharpness_ratio: 0.0,
      873:             agreement_ratio: (predicted_improvement > 0.0)
      874:                 .then_some(f64::from(observed_improvement) / f64::from(predicted_improvement)),
      875:         }
      876:     }
      877:
      878:     pub(super) fn observe(
      879:         &mut self,
      880:         observed_improvement: f32,
      881:         observation_variance: f32,
      882:         predicted_improvement: f32,
      883:         prediction_variance: f32,
      884:         response_radius: f32,
      885:         calibrate: bool,
      886:     ) -> Decision {
      887:         let improvement = f64::from(observed_improvement);
      888:         let threshold =
      889:             f64::from(self.calibration.multiplier()) * f64::from(observation_variance).sqrt();
      890:         let accepted = improvement > threshold;
      891:         let predicted_improvement = f64::from(predicted_improvement);
      892:         let observation_variance = f64::from(observation_variance);
      893:         let prediction_variance = f64::from(prediction_variance);
      894:         let scale = (observation_variance + prediction_variance)
      895:             .sqrt()
      896:             .max(MIN_SCALE);
      897:         let standardized_error = (improvement - predicted_improvement).abs() / scale;
      898:         let response_scale = f64::from(response_radius)
      899:             .max(observation_variance.sqrt())
      900:             .max(MIN_SCALE);
      901:         let sharpness_ratio = prediction_variance.sqrt() / response_scale;
      902:         let adequate = standardized_error <= 2.0 && sharpness_ratio <= 2.0;
      903:         self.adequate = PRIOR + 0.9 * (self.adequate - PRIOR) + if adequate { 1.0 } else { 0.0 };
      904:         self.inadequate =
      905:             PRIOR + 0.9 * (self.inadequate - PRIOR) + if adequate { 0.0 } else { 1.0 };
      906:
      907:         let previous_conversion = self.log_conversion.map(f64::exp);
      908:         let boundary = previous_conversion.map(|conversion| conversion * self.radius);
      909:         let reached = boundary
      910:             .filter(|value| *value > 0.0)
      911:             .map(|value| f64::from(response_radius) / value);
      912:         if response_radius > 0.0 {
      913:             let sample = (f64::from(response_radius) / self.radius).ln();
      914:             self.log_conversion = Some(
      915:                 self.log_conversion
      916:                     .map_or(sample, |previous| 0.9 * previous + 0.1 * sample),
      917:             );
      918:         }
      919:
      920:         let total = self.adequate + self.inadequate;
      921:         let mean = self.adequate / total;
      922:         let beta_variance = self.adequate * self.inadequate / (total * total * (total + 1.0));
      923:         let lower = (mean - 2.0 * beta_variance.sqrt()).clamp(0.0, 1.0);
      924:         let upper = (mean + 2.0 * beta_variance.sqrt()).clamp(0.0, 1.0);
      925:         let evidence = (total - 2.0).max(0.0);
      926:         let reliable = evidence >= 4.0 && lower >= 0.6;
      927:         let unreliable = evidence >= 4.0 && upper < 0.6;
      928:         let agreement_ratio =
      929:             (predicted_improvement > MIN_SCALE).then_some(improvement / predicted_improvement);
      930:         let boundary_step = reached.is_none_or(|value| value >= 0.8);
      931:         let action = if unreliable {
      932:             ReliabilityAction::Shrink
      933:         } else if reliable
      934:             && accepted
      935:             && agreement_ratio.is_some_and(|value| value >= 0.1)
      936:             && boundary_step
      937:         {
      938:             ReliabilityAction::Expand
      939:         } else {
      940:             ReliabilityAction::Hold
      941:         };
      942:         self.radius = match action {
      943:             ReliabilityAction::Hold => self.radius,
      944:             ReliabilityAction::Expand => self.radius * 2.0,
      945:             ReliabilityAction::Shrink => self.radius * 0.5,
      946:         }
      947:         .clamp(self.minimum, self.maximum);
      948:         if calibrate {
      949:             self.calibration.observe(
      950:                 observed_improvement,
      951:                 predicted_improvement as f32,
      952:                 (observation_variance + prediction_variance).sqrt() as f32,
      953:             );
      954:         }
      955:         Decision {
      956:             accepted,
      957:             improvement,
      958:             threshold,
      959:             predicted_improvement,
      960:             action,
      961:             next_radius: self.radius(),
      962:             standardized_error,
      963:             sharpness_ratio,
      964:             agreement_ratio,
      965:         }
      966:     }
      967: }
