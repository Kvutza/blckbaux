      762: struct Calibration {
      763:     errors: [f32; CALIBRATION_CAPACITY],
      764:     count: usize,
      765:     next: usize,
      766: }
      767:
      768: impl Default for Calibration {
      769:     fn default() -> Self {
      770:         Self {
      771:             errors: [0.0; CALIBRATION_CAPACITY],
      772:             count: 0,
      773:             next: 0,
      774:         }
      775:     }
      776: }
      777:
      778: impl Calibration {
      779:     fn multiplier(&self) -> f32 {
      780:         let rank = ((self.count + 1) * 95).div_ceil(100);
      781:         if rank == 0 || rank > self.count {
      782:             return 2.0;
      783:         }
      784:         let mut ordered = self.errors;
      785:         ordered[..self.count].sort_unstable_by(f32::total_cmp);
      786:         ordered[rank - 1].max(2.0)
      787:     }
      788:
      789:     fn observe(&mut self, observed: f32, predicted: f32, scale: f32) {
      790:         self.errors[self.next] = ((observed - predicted).abs() / scale.max(1.0e-6)).min(f32::MAX);
      791:         self.next = (self.next + 1) % CALIBRATION_CAPACITY;
      792:         self.count = (self.count + 1).min(CALIBRATION_CAPACITY);
      793:     }
      794: }
