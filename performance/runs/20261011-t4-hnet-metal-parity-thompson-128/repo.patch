      410: pub(super) struct ZigguratTables {
      411:     pub thresholds: [u32; 256],
      412:     pub widths: [f32; 256],
      413:     pub densities: [f32; 256],
      414: }
      415:
      416: pub(super) fn ziggurat_tables() -> ZigguratTables {
      417:     const R: f64 = 3.654_152_885_361_009;
      418:     const V: f64 = 0.004_928_673_233_99;
      419:     let mut thresholds = [0; 256];
      420:     let mut widths = [0.0; 256];
      421:     let mut densities = [0.0; 256];
      422:     let scale = 2_147_483_648.0;
      423:     let mut boundary = R;
      424:     let mut previous = boundary;
      425:     let tail_density = (-0.5 * boundary * boundary).exp();
      426:     let tail_width = V / tail_density;
      427:     thresholds[0] = (boundary / tail_width * scale) as u32;
      428:     thresholds[1] = 0;
      429:     widths[0] = (tail_width / scale) as f32;
      430:     widths[255] = (boundary / scale) as f32;
      431:     densities[0] = 1.0;
      432:     densities[255] = tail_density as f32;
      433:     for layer in (1..255).rev() {
      434:         boundary = (-2.0 * (V / boundary + (-0.5 * boundary * boundary).exp()).ln()).sqrt();
      435:         thresholds[layer + 1] = (boundary / previous * scale) as u32;
      436:         previous = boundary;
      437:         densities[layer] = (-0.5 * boundary * boundary).exp() as f32;
      438:         widths[layer] = (boundary / scale) as f32;
      439:     }
      440:     ZigguratTables {
      441:         thresholds,
      442:         widths,
      443:         densities,
      444:     }
      445: }
      446:
      447: #[inline]
      448: fn ziggurat_bits(seed: u64, key: u64, element: u64, attempt: u32, stream: u32) -> u32 {
      449:     let domain = seed as u32
      450:         ^ ((seed >> 32) as u32).wrapping_mul(0xc2b2_ae35)
      451:         ^ (key as u32).wrapping_mul(0x27d4_eb2f)
      452:         ^ ((key >> 32) as u32).wrapping_mul(0x1656_67b1);
      453:     let counter = (element as u32).wrapping_mul(0x9e37_79b9)
      454:         ^ ((element >> 32) as u32).wrapping_mul(0x85eb_ca6b);
      455:     mix32(domain ^ counter ^ attempt.wrapping_mul(0xd3a2_646c) ^ stream.wrapping_mul(0xfd70_46c5))
      456: }
      457:
      458: #[inline]
      459: fn ziggurat_uniform(bits: u32) -> f32 {
      460:     (((bits >> 8) + 1) as f32 * 2.0f32.powi(-24)).min(0.999_999_94)
      461: }
      462:
      463: fn normal(seed: u64, key: u64, element: u64, tables: &ZigguratTables) -> f32 {
      464:     for attempt in 0..u32::MAX {
      465:         let bits = ziggurat_bits(seed, key, element, attempt, 0);
      466:         let signed = bits as i32;
      467:         let layer = bits as usize & 255;
      468:         let magnitude = signed.unsigned_abs();
      469:         let sample = signed as f32 * tables.widths[layer];
      470:         if magnitude < tables.thresholds[layer] {
      471:             return sample;
      472:         }
      473:         if layer == 0 {
      474:             for tail in 0..u32::MAX - attempt {
      475:                 let x = -ziggurat_uniform(ziggurat_bits(seed, key, element, attempt + tail, 1))
      476:                     .ln()
      477:                     / 3.654_152_9;
      478:                 let y =
      479:                     -ziggurat_uniform(ziggurat_bits(seed, key, element, attempt + tail, 2)).ln();
      480:                 if 2.0 * y >= x * x {
      481:                     return if signed < 0 {
      482:                         -3.654_152_9 - x
      483:                     } else {
      484:                         3.654_152_9 + x
      485:                     };
      486:                 }
      487:             }
      488:         } else {
      489:             let uniform = ziggurat_uniform(ziggurat_bits(seed, key, element, attempt, 1));
      490:             let density = tables.densities[layer]
      491:                 + uniform * (tables.densities[layer - 1] - tables.densities[layer]);
      492:             if density < (-0.5 * sample * sample).exp() {
      493:                 return sample;
      494:             }
      495:         }
      496:     }
      497:     unreachable!("Ziggurat retry counter exhausted")
      498: }
