      620: pub(super) struct ResponseCandidate {
      621:     pub seed: u64,
      622:     pub coefficients: [f32; RESPONSE_GROUPS],
      623:     pub uncertainty: [f32; RESPONSE_GROUPS],
      624:     pub features: [f32; RESPONSE_GROUPS],
      625:     pub response_mean: f32,
      626:     pub response_variance: f32,
      627:     pub prediction: Prediction,
