     1346:                     MetalAction::Expand => ReliabilityAction::Expand,
     1347:                     MetalAction::Shrink => ReliabilityAction::Shrink,
     1348:                 }
     1349:             );
     1350:             assert_eq!(
     1351:                 cuda_decision.next_radius.to_bits(),
     1352:                 (metal.length() as f32).to_bits()
     1353:             );
     1354:             assert_eq!(
     1355:                 cuda_decision.standardized_error.to_bits(),
     1356:                 metal_telemetry.standardized_error.unwrap().to_bits()
     1357:             );
     1358:             assert_eq!(
     1359:                 cuda_decision.sharpness_ratio.to_bits(),
     1360:                 metal_telemetry.sharpness_ratio.unwrap().to_bits()
     1361:             );
     1362:         }
     1363:     }
