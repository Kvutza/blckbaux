       80: fn validate_hnet_tasks(
       81:     model: &mut FbtModel,
       82:     tasks: &[HnetTask],
       83:     visits: usize,
       84:     temperature: f32,
       85:     evaluation_seed: u64,
       86:     round: usize,
       87:     phase: &str,
       88:     progress: &mut BufWriter<fs::File>,
       89: ) -> CudaResult<blckbaux_wire::json::Value> {
       90:     let started = std::time::Instant::now();
       91:     let mut rewards = Vec::with_capacity(tasks.len());
       92:     let mut nlls = Vec::with_capacity(tasks.len());
       93:     let mut device_ms = 0.0_f32;
       94:     for task in tasks {
       95:         model.configure_hnet(&task.prompt, task.targets.len(), Some(&task.targets))?;
       96:         let evaluation = model.evaluate_hnet(visits, temperature, evaluation_seed)?;
       97:         let stats = evaluation
       98:             .stats
       99:             .ok_or("CUDA H-Net held-out task was not scored")?;
      100:         rewards.push(stats.reward);
      101:         nlls.push(stats.mean_nll);
      102:         device_ms += evaluation.device_ms;
      103:     }
      104:     let mean_reward = rewards.iter().sum::<f32>() / rewards.len() as f32;
      105:     let mean_nll = nlls.iter().sum::<f32>() / nlls.len() as f32;
      106:     let record = blckbaux_wire::json::json!({
      107:         "schema": "blckbaux.cuda.hnet-validation.v1",
      108:         "phase": phase,
      109:         "round": round,
      110:         "tasks": tasks.len(),
      111:         "reward": mean_reward,
      112:         "mean_nll": mean_nll,
      113:         "task_rewards": rewards,
      114:         "task_nlls": nlls,
      115:         "device_ms": device_ms,
      116:         "wall_ms": started.elapsed().as_secs_f64() * 1000.0,
      117:         "used_for_acceptance": false,
      118:         "excluded_from_round_timing": true
      119:     });
      120:     writeln!(
      121:         progress,
      122:         "{}",
      123:         blckbaux_wire::json::to_string(&record).map_err(|e| e.to_string())?
      124:     )
      125:     .map_err(|e| format!("write CUDA H-Net validation log: {e}"))?;
      126:     progress
      127:         .flush()
      128:         .map_err(|e| format!("flush CUDA H-Net validation log: {e}"))?;
      129:     Ok(record)
 120  130: }
