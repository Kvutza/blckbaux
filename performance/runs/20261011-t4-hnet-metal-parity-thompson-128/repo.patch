      373: #[inline]
      374: pub(super) fn splitmix64(value: u64) -> u64 {
      375:     let value = value.wrapping_add(0x9e37_79b9_7f4a_7c15);
      376:     let mut mixed = value;
      377:     mixed = (mixed ^ (mixed >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
      378:     mixed = (mixed ^ (mixed >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
      379:     mixed ^ (mixed >> 31)
      380: }
