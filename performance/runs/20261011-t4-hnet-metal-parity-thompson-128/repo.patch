      382: #[inline]
      383: fn mix32(mut value: u32) -> u32 {
      384:     value ^= value >> 16;
      385:     value = value.wrapping_mul(0x7feb_352d);
      386:     value ^= value >> 15;
      387:     value = value.wrapping_mul(0x846c_a68b);
      388:     value ^ (value >> 16)
      389: }
      390:
      391: #[inline]
      392: fn stream_word(low: u32, high: u32, element: u32) -> u32 {
      393:     let mut value = low ^ element.wrapping_mul(0x9e37_79b9);
      394:     value ^= value >> 16;
      395:     value = value.wrapping_mul(0x7feb_352d);
      396:     value ^= high;
      397:     value = value.wrapping_mul(0x846c_a68b);
      398:     value ^ (value >> 15)
      399: }
