       52: fn validate_hnet_task(task: &HnetTask, generated_cap: usize) -> CudaResult<()> {
       53:     if task.prompt.is_empty()
       54:         || task.prompt.len() % 64 != 0
       55:         || task.targets.is_empty()
       56:         || task.targets.len() % 64 != 0
       57:         || task.targets.len() > generated_cap
       58:         || task
       59:             .prompt
       60:             .iter()
       61:             .chain(&task.targets)
       62:             .any(|&token| token >= VOCAB as u32)
       63:     {
       64:         return Err("CUDA H-Net BO tasks require vocabulary-valid, nonempty 64-token prompt/target patches within GENERATED_TOKENS".into());
       65:     }
       66:     Ok(())
       67: }
