      298: fn posterior(
      299:     distances: &[f32],
      300:     outcomes: &[f32],
      301:     variances: &[f32],
      302:     params: EnnParams,
      303:     y_scale: f64,
      304:     excluded: Option<usize>,
      305:     adaptive_neighbors: bool,
      306: ) -> (f64, f64) {
