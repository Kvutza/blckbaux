      500: #[inline]
      501: fn response_sign(seed: u64, key: u64, element: u64) -> f32 {
      502:     let bits = mix32(
      503:         seed as u32
      504:             ^ ((seed >> 32) as u32).wrapping_mul(0xc2b2_ae35)
      505:             ^ (key as u32).wrapping_mul(0x27d4_eb2f)
      506:             ^ ((key >> 32) as u32).wrapping_mul(0x1656_67b1)
      507:             ^ (element as u32).wrapping_mul(0x9e37_79b9)
      508:             ^ ((element >> 32) as u32).wrapping_mul(0x85eb_ca6b),
      509:     );
      510:     if bits & 1 == 0 { -1.0 } else { 1.0 }
      511: }
