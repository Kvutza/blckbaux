      210:     fn fit(&mut self) -> Result<(), String> {
      211:         let n = self.len;
      212:         let sum = self.outcomes[..n]
      213:             .iter()
      214:             .map(|&value| f64::from(value))
      215:             .sum::<f64>();
      216:         let sumsq = self.outcomes[..n]
      217:             .iter()
      218:             .map(|&value| f64::from(value).powi(2))
      219:             .sum::<f64>();
      220:         let mean = sum / n as f64;
      221:         let variance = (sumsq / n as f64 - mean * mean).max(0.0);
      222:         self.y_scale = variance.sqrt();
      223:         if !self.y_scale.is_finite() || self.y_scale <= 0.0 {
      224:             self.y_scale = 1.0;
      225:         }
      226:         let mut rng = StdRng::seed_from_u64(self.fit_seed.wrapping_add(n as u64));
      227:         let mut candidates = Vec::with_capacity(self.fit_candidates + 1);
      228:         // ENNFitter draws every epistemic scale first, followed by every
      229:         // aleatoric scale. Preserve that RNG order so CUDA and Metal select
      230:         // the same likelihood candidate from the same fit seed.
      231:         let epistemic = (0..self.fit_candidates)
      232:             .map(|_| 10.0_f64.powf(rng.gen_range(-3.0..=3.0)))
      233:             .collect::<Vec<_>>();
      234:         let aleatoric = (0..self.fit_candidates)
      235:             .map(|_| 10.0_f64.powf(rng.gen_range(-3.0..=3.0)))
      236:             .collect::<Vec<_>>();
      237:         for (&epistemic, &aleatoric) in epistemic.iter().zip(&aleatoric) {
      238:             candidates.push(EnnParams {
      239:                 neighbors: self.params.neighbors,
      240:                 epistemic,
      241:                 aleatoric,
      242:             });
      243:         }
      244:         candidates.push(self.params);
      245:         let selected = sampled_rows(n, self.fit_samples, &mut rng);
      246:         let mut best: Option<(EnnParams, f64)> = None;
      247:         for candidate in candidates {
      248:             let score = self.leave_one_out(candidate, &selected);
      249:             if score.is_finite() && best.is_none_or(|(_, best_score)| score >= best_score) {
      250:                 best = Some((candidate, score));
      251:             }
      252:         }
      253:         // Metal fits only the epistemic and aleatoric scales at the configured
      254:         // maximum k. With fit.neighbors enabled, each query chooses its own
      255:         // prefix below; k is not another global likelihood parameter.
      256:         self.params = best
      257:             .ok_or("CUDA ENN scale fitting produced no finite candidate")?
      258:             .0;
      259:         self.fitted = true;
      260:         Ok(())
      261:     }
      262:
      263:     fn leave_one_out(&self, params: EnnParams, selected: &[usize]) -> f64 {
      264:         let mut score = 0.0;
      265:         for &held in selected {
      266:             let (mean, standard_error) = posterior(
      267:                 &self.distances[held][..self.len],
      268:                 &self.outcomes[..self.len],
      269:                 &self.variances[..self.len],
      270:                 params,
      271:                 self.y_scale,
      272:                 Some(held),
      273:                 false,
      274:             );
      275:             if !mean.is_finite() || !standard_error.is_finite() || standard_error <= 0.0 {
      276:                 return f64::NEG_INFINITY;
      277:             }
      278:             let target = f64::from(self.outcomes[held]) / self.y_scale;
      279:             let mean = mean / self.y_scale;
      280:             let standard_error = standard_error / self.y_scale;
      281:             let residual = (target - mean) / standard_error;
      282:             score += -0.5 * (2.0 * std::f64::consts::PI).ln()
      283:                 - standard_error.ln()
      284:                 - 0.5 * residual * residual;
      285:         }
      286:         score
      287:     }
      288: }
