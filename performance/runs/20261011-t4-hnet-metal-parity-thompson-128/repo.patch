      401: /// Adjacent Metal pool slots share their candidate stream.
      402: pub(super) fn candidate_seed(root: u64, candidate: usize) -> u64 {
      403:     let stream = candidate as u32 / 2;
      404:     let low = root as u32;
      405:     let high = (root >> 32) as u32;
      406:     u64::from(stream_word(low, high, stream))
      407:         | (u64::from(stream_word(high, low, stream ^ 0x9e37_79b9)) << 32)
      408: }
