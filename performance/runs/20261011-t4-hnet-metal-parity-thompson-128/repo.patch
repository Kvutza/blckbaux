      308:         .filter(|index| Some(*index) != excluded)
      309:         .collect::<Vec<_>>();
      310:     nearest.sort_by(|&left, &right| {
      311:         distances[left]
      312:             .total_cmp(&distances[right])
      313:             .then(left.cmp(&right))
      314:     });
      315:     nearest.truncate(params.neighbors.min(nearest.len()));
      316:     if nearest.is_empty() {
      317:         let fallback = excluded.unwrap_or(0).min(outcomes.len() - 1);
      318:         return (
      319:             f64::from(outcomes[fallback]),
      320:             params.aleatoric.max(1.0e-12).sqrt() * y_scale,
      321:         );
      322:     }
      323:     let scale_squared = (y_scale * y_scale).max(1.0e-12);
      324:     if adaptive_neighbors {
      325:         // Match Metal's query-local prefix selection. Scale fitting itself uses
      326:         // the configured maximum k, exactly as ENNFitter::ask_distances does.
      327:         let mut precision_sum = 0.0;
      328:         let mut noise_sum = 0.0;
      329:         let mut best_risk = f64::INFINITY;
      330:         let mut chosen = 1;
      331:         for (position, &index) in nearest.iter().enumerate() {
      332:             let noise = params.aleatoric + f64::from(variances[index]) / scale_squared;
      333:             let precision = 1.0
      334:                 / (1.0e-9 + params.epistemic * f64::from(distances[index]) + noise).max(1.0e-12);
      335:             precision_sum += precision;
      336:             noise_sum += precision * precision * noise;
      337:             let risk = params.epistemic * f64::from(distances[index])
      338:                 + noise_sum / (precision_sum * precision_sum).max(1.0e-24);
      339:             if risk < best_risk {
      340:                 best_risk = risk;
      341:                 chosen = position + 1;
      342:             }
      343:         }
      344:         nearest.truncate(chosen);
      345:     }
      346:     let weights = nearest
      347:         .iter()
      348:         .map(|&index| {
      349:             1.0 / (1.0e-9
      350:                 + params.epistemic * f64::from(distances[index])
      351:                 + params.aleatoric
      352:                 + f64::from(variances[index]) / scale_squared)
      353:         })
      354:         .collect::<Vec<_>>();
      355:     let total = weights.iter().sum::<f64>().max(1.0e-12);
      356:     let mean = nearest
      357:         .iter()
      358:         .zip(&weights)
      359:         .map(|(&index, &weight)| weight * f64::from(outcomes[index]))
      360:         .sum::<f64>()
      361:         / total;
      362:     let aleatoric = nearest
      363:         .iter()
      364:         .zip(&weights)
      365:         .map(|(&index, &weight)| {
      366:             weight / total * (params.aleatoric + f64::from(variances[index]) / scale_squared)
      367:         })
      368:         .sum::<f64>();
      369:     let standard_error = (1.0 / total + aleatoric).max(1.0e-12).sqrt() * y_scale;
      370:     (mean, standard_error)
      371: }
