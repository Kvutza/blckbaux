       37: fn hnet_tasks(prompt_path: &str, target_path: &str) -> CudaResult<Vec<HnetTask>> {
       38:     let prompts = hnet_token_rows(prompt_path)?;
       39:     let targets = hnet_token_rows(target_path)?;
       40:     if prompts.len() != targets.len() || prompts.is_empty() {
       41:         return Err(
       42:             "H-Net prompt and target files must contain the same positive row count".into(),
       43:         );
