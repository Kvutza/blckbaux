      212: impl NeighborSampler {
      213:     fn new(specs: &[ProposalSpec], stream: &CudaStream) -> CudaResult<Self> {
      214:         // The packed CUDA embedding is a second physical view of Metal's one
      215:         // logical embedding/readout tensor.  It is materialized, but only the
      216:         // row-major readout participates in neighbour geometry.
      217:         let dimensions = specs
      218:             .iter()
      219:             .filter(|spec| spec.transpose_columns == 0)
      220:             .try_fold(0_usize, |sum, spec| sum.checked_add(spec.elements))
      221:             .ok_or("CUDA neighbour dimensions overflow")?;
      222:         let mut points = Vec::new();
      223:         let mut ranges = Vec::new();
      224:         for (buffer, spec) in specs.iter().enumerate() {
      225:             if spec.transpose_columns != 0 {
      226:                 continue;
      227:             }
      228:             let range_start = u32::try_from(points.len()).map_err(cuda_error)?;
      229:             let block_len = spec.block_len as usize;
      230:             for block in 0..spec.host_scales.len() {
      231:                 let count = (8192usize.saturating_mul(block_len) / dimensions)
      232:                     .max(8)
      233:                     .min(block_len);
      234:                 let key = response_block_key(
      235:                     spec.tensor_id,
      236:                     spec.logical_start + (block * block_len) as u64,
      237:                     block_len as u64,
      238:                 );
      239:                 let scale = spec.host_scales[block];
      240:                 let weight = 1.0 / (block_len as f32 * scale * scale);
      241:                 for stratum in 0..count {
      242:                     let start = stratum * block_len / count;
      243:                     let end = (stratum + 1) * block_len / count;
      244:                     let element = start
      245:                         + splitmix(key ^ (stratum as u64).wrapping_mul(0x9e37_79b9_7f4a_7c15))
      246:                             as usize
      247:                             % (end - start);
      248:                     points.push(HnetNeighborPoint {
      249:                         physical: (block * block_len + element) as u64,
      250:                         key,
      251:                         element: element as u64,
      252:                         metric_weight: (end - start) as f32 * weight,
      253:                         scale,
      254:                     });
      255:                 }
      256:             }
      257:             let count = u32::try_from(points.len()).map_err(cuda_error)? - range_start;
      258:             ranges.push(NeighborRange {
      259:                 buffer,
      260:                 start: range_start,
      261:                 count,
      262:             });
      263:         }
      264:         let total = u32::try_from(points.len()).map_err(cuda_error)?;
      265:         if total == 0 {
      266:             return Err("CUDA neighbour quadrature is empty".into());
      267:         }
      268:         let total_usize = total as usize;
      269:         Ok(Self {
      270:             points: DeviceBuffer::from_host(stream, &points).map_err(cuda_error)?,
      271:             seeds: DeviceBuffer::zeroed(stream, 4).map_err(cuda_error)?,
      272:             pool: DeviceBuffer::zeroed(stream, 4 * total_usize).map_err(cuda_error)?,
      273:             history: DeviceBuffer::zeroed(stream, 128 * total_usize).map_err(cuda_error)?,
      274:             distances: DeviceBuffer::zeroed(stream, 4 * 128).map_err(cuda_error)?,
      275:             ranges,
      276:             total,
      277:         })
      278:     }
      279: }
