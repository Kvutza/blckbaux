 use cuda_core::{DeviceBuffer, LaunchConfig1D};
 use blckbaux_cuda_kernels::{ObjectiveShape, ScoreStats};
 use half::f16;
+use rand::{Rng, SeedableRng, rngs::StdRng};
+use rand_distr::StandardNormal;
 use std::fs;
