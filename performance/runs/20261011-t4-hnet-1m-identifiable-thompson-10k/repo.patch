+    /// Materialize a dense proposal from one visible coefficient per tensor.
+    /// The fixed counter-generated basis gives every coordinate support while
+    /// keeping the executed perturbation exactly identifiable to the surrogate.
+    #[kernel(unchecked_indexing)]
+    #[launch_bounds(256)]
+    #[launch_contract(domain = 1, block = (256, 1, 1), dynamic_shared = 0)]
+    pub fn gaussian_fp16(
+        base: &[u16],
+        scales: &[f32],
+        mut candidate: DisjointSlice<u16>,
+        elements: u64,
+        block_len: u32,
+        radius: f32,
+        key: u64,
+        tensor_coefficient: f32,
+    ) {
+        let mut index = u64::from(thread::blockIdx_x()) * 256 + u64::from(thread::threadIdx_x());
+        let stride = u64::from(thread::gridDim_x()) * 256;
+        while index < elements {
+            let block = index / u64::from(block_len);
+            let basis = dense_normal(0x656e_6e78_2d67_6175, key, index);
+            let direction = tensor_coefficient * basis;
+            let value = half(base[index as usize]) + scales[block as usize] * radius * direction;
+            unsafe { *candidate.get_unchecked_mut(index as usize) = half_bits(value) };
+            index += stride;
+        }
+    }
+
