 use std::path::Path;

+// One explicit posterior coordinate per resident model tensor.  This keeps the
+// ENN metric identical to the dense perturbation executed by the CUDA kernel.
+const HNET_FEATURES: usize = 70;
+const HNET_CANDIDATES: usize = 4;
+const HNET_NEIGHBORS: usize = 32;
+
+#[derive(Clone, Copy)]
+enum HnetAcquisition {
+    Ucb,
+    Thompson,
+}
+
+impl HnetAcquisition {
+    fn parse(value: Option<&String>) -> CudaResult<Self> {
+        match value.map(String::as_str).unwrap_or("ucb") {
+            "ucb" => Ok(Self::Ucb),
+            "thompson" => Ok(Self::Thompson),
+            other => Err(format!("unsupported CUDA H-Net acquisition {other}").into()),
+        }
+    }
+
+    const fn name(self) -> &'static str {
+        match self {
+            Self::Ucb => "ucb",
+            Self::Thompson => "thompson",
+        }
+    }
+}
+
+#[derive(Clone)]
+struct HnetObservation {
+    coordinates: [f32; HNET_FEATURES],
+    reward: f32,
+    variance: f32,
+}
+
+fn mix_seed(value: u64) -> u64 {
+    let value = value.wrapping_add(0x9e37_79b9_7f4a_7c15);
+    let mut mixed = value;
+    mixed = (mixed ^ (mixed >> 30)).wrapping_mul(0xbf58_476d_1ce4_e5b9);
+    mixed = (mixed ^ (mixed >> 27)).wrapping_mul(0x94d0_49bb_1331_11eb);
+    mixed ^ (mixed >> 31)
+}
+
+fn gaussian_features(seed: u64) -> [f32; HNET_FEATURES] {
+    let mut random = StdRng::seed_from_u64(seed);
+    std::array::from_fn(|_| random.sample(StandardNormal))
+}
+
+fn descriptor(
+    center: &[f32; HNET_FEATURES],
+    direction: &[f32; HNET_FEATURES],
+    radius: f32,
+) -> [f32; HNET_FEATURES] {
+    std::array::from_fn(|index| center[index] + radius * direction[index])
+}
+
+fn descriptor_distance(left: &[f32; HNET_FEATURES], right: &[f32; HNET_FEATURES]) -> f32 {
+    left.iter()
+        .zip(right)
+        .map(|(a, b)| (a - b).powi(2))
+        .sum::<f32>()
+        / HNET_FEATURES as f32
+}
+
+fn enn_acquisition(
+    query: &[f32; HNET_FEATURES],
+    history: &[HnetObservation],
+    acquisition: HnetAcquisition,
+    draw_seed: u64,
+) -> f32 {
+    let mut nearest = history
+        .iter()
+        .enumerate()
+        .map(|(index, observation)| (descriptor_distance(query, &observation.coordinates), index))
+        .collect::<Vec<_>>();
+    nearest.sort_by(|left, right| left.0.total_cmp(&right.0).then(left.1.cmp(&right.1)));
+    nearest.truncate(HNET_NEIGHBORS.min(nearest.len()));
+    let mut weight_sum = 0.0_f32;
+    let mut weighted_reward = 0.0_f32;
+    let mut weighted_aleatoric = 0.0_f32;
+    let mut weights = Vec::with_capacity(nearest.len());
+    for &(distance, index) in &nearest {
+        let variance = 1.0e-9 + 0.05 * distance + 0.05 + history[index].variance;
+        let weight = variance.max(1.0e-12).recip();
+        weight_sum += weight;
+        weighted_reward += weight * history[index].reward;
+        weighted_aleatoric += weight * (0.05 + history[index].variance);
+        weights.push(weight);
+    }
+    let mean = weighted_reward / weight_sum.max(1.0e-12);
+    let uncertainty = ((1.0 + weighted_aleatoric) / weight_sum.max(1.0e-12)).sqrt();
+    match acquisition {
+        HnetAcquisition::Ucb => mean + uncertainty,
+        HnetAcquisition::Thompson => {
+            let mut random = StdRng::seed_from_u64(draw_seed);
+            let reference = weights.iter().copied().fold(f32::MIN_POSITIVE, f32::max);
+            let mut noise = 0.0_f32;
+            let mut squared = 0.0_f32;
+            for weight in weights {
+                let normalized = weight / reference;
+                noise += normalized * random.sample::<f32, _>(StandardNormal);
+                squared += normalized * normalized;
+            }
+            mean + uncertainty * noise / squared.sqrt().max(1.0e-12)
+        }
+    }
+}
