#!/bin/sh
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$repo_dir"
if [ "$(uname -s)" = Linux ] && [ "${1:-}" = cuda ] && [ "${2:-}" = setup ]; then
    shift 2
    exec ./tools/cuda-setup "$@"
fi
if [ "$(uname -s)" = Linux ] && [ "${1:-}" = cuda ] && [ "${2:-}" = tune-t4 ]; then
    shift 2
    cargo_home=${CARGO_HOME:-"$HOME/.cargo"}
    cargo_bin="$cargo_home/bin/cargo"
    [ -x "$cargo_bin" ] || cargo_bin=cargo
    exec "$cargo_bin" run --release -p blckbaux-runner --bin blckbaux-runner -- \
        cuda-tune-t4 "$@"
fi
case "${BLCKBAUX_BUILD_SYSTEM:-buck2}" in
    buck2)
        built=$(./tools/buck2w build --console none -v 0 --show-full-output //rust/crates/cli:blckbaux)
        case "$built" in
            "root//rust/crates/cli:blckbaux "*) binary=${built#* } ;;
            *) echo "blckbaux: could not resolve the Buck2 CLI artifact" >&2; exit 1 ;;
        esac
        [ -x "$binary" ] || { echo "blckbaux: Buck2 CLI artifact is not executable" >&2; exit 1; }
        exec "$binary" "$@"
        ;;
    bazel) exec bazel run --config=release --config=constrained //rust/crates/cli:blckbaux -- "$@" ;;
    *) echo "blckbaux: BLCKBAUX_BUILD_SYSTEM must be buck2 or bazel" >&2; exit 1 ;;
esac
